# .gitignore for rust-tidecoin repository workspace.

# Lock files
Cargo.lock
internals/Cargo.lock
bitcoin/Cargo.lock
hashes/Cargo.lock

# Build artifacts
target
internals/target
bitcoin/target
hashes/target

# Test artifacts
bitcoin/dep_test
mutants.out*
fuzz/coverage

# Python tooling artifacts
__pycache__/
*.py[cod]

# Local tooling
.maintainer-tools
